{
    "name": "laravel/laravel",
    "type": "project",
    "description": "alanvaghteshe shemiranweb project.",
    "keywords": [
        "laravel",
        "framework",
        "alanvaghteshe",
        "shemiranweb"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "google/recaptcha": "^1.3",
        "guzzlehttp/guzzle": "^7.8.1",
        "hekmatinasser/verta": "^8.3",
        "intervention/image": "^3.11",
        "irazasyed/telegram-bot-sdk": "^3.15",
        "laravel-notification-channels/fcm": "^4.0",
        "laravel/framework": "^10.35.0",
        "laravel/octane": "^2.8",
        "laravel/sanctum": "^3.3",
        "laravel/tinker": "^2.8.2",
        "livewire/livewire": "^3.2.6",
        "mhmiton/laravel-modules-livewire": "v2.2.0",
        "nwidart/laravel-modules": "^10.0",
        "pusher/pusher-php-server": "^7.2",
        "shetabit/payment": "^5.8",
        "spatie/laravel-permission": "^6.2.0",
        "spiral/roadrunner-cli": "^2.6.0",
        "spiral/roadrunner-http": "^3.3.0",
        "tecnickcom/tcpdf": "^6.6.5"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.14",
        "barryvdh/laravel-ide-helper": "^2.13",
        "doctrine/dbal": "^3.10",
        "fakerphp/faker": "^1.23.0",
        "laravel/pint": "^1.13.7",
        "laravel/sail": "^1.26.3",
        "mockery/mockery": "^1.6.6",
        "nunomaduro/collision": "^7.10.0",
        "pestphp/pest": "*",
        "phpunit/phpunit": "^10.5.2",
        "spatie/laravel-ignition": "^2.3.1"
    },
    "autoload": {
        "files": [
            "helper/jdf.php",
            "helper/function.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {

        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan ide-helper:models --write"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
